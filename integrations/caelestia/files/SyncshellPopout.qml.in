pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Layouts
import Caelestia.Config
import qs.components
import qs.components.controls
import qs.services

ColumnLayout {
  id: root
  implicitWidth: 420
  spacing: Tokens.spacing.medium
  property bool moreOpen: false
  property bool addOpen: false
  property string pendingForgetId: ""
  property string pendingForgetLabel: ""

  function requestForget(folder) {
    pendingForgetId = String(folder.id || "")
    pendingForgetLabel = String(folder.label || folder.id || "folder")
  }

  function confirmForget() {
    if (pendingForgetId === "") return
    if (Syncshell.forgetFolder(pendingForgetId)) pendingForgetId = ""
  }

  Keys.onPressed: function(event) {
    if (event.key === Qt.Key_Escape && pendingForgetId !== "") {
      pendingForgetId = ""
      event.accepted = true
    } else {
      event.accepted = false
    }
  }

  StyledText {
    Layout.fillWidth: true
    text: qsTr("Syncshell")
    color: Colours.palette.m3primary
    font: Tokens.font.title.medium
  }

  StyledText {
    Layout.fillWidth: true
    text: Syncshell.summaryText
  }

  StyledText {
    Layout.fillWidth: true
    visible: text.length > 0
    text: Syncshell.lastError || Syncshell.actionNotice
    color: Syncshell.lastError ? Colours.palette.m3error
      : Colours.palette.m3primary
    wrapMode: Text.Wrap
  }

  StyledText {
    Layout.fillWidth: true
    text: qsTr("FOLDERS")
    color: Colours.palette.m3onSurfaceVariant
  }

  Flickable {
    id: folderView
    Layout.fillWidth: true
    Layout.preferredHeight: Math.min(300,
      Math.max(60, folderColumn.implicitHeight))
    clip: true
    contentWidth: width
    contentHeight: folderColumn.implicitHeight
    boundsBehavior: Flickable.StopAtBounds

    Column {
      id: folderColumn
      width: folderView.width
      spacing: Tokens.spacing.small

      StyledText {
        width: parent.width
        visible: Syncshell.folders.length === 0
        text: Syncshell.summaryText
        color: Colours.palette.m3onSurfaceVariant
        horizontalAlignment: Text.AlignHCenter
      }

      Repeater {
        model: Syncshell.folders
        delegate: StyledRect {
          id: folderCard
          required property var modelData
          width: folderColumn.width
          height: details.implicitHeight + Tokens.padding.medium * 2
          color: Colours.tPalette.m3surfaceContainer
          radius: Tokens.rounding.medium

          ColumnLayout {
            id: details
            anchors.fill: parent
            anchors.margins: Tokens.padding.medium
            spacing: Tokens.spacing.small
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.label
                || folderCard.modelData.id)
              font: Tokens.font.label.large
            }
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.path || "")
              color: Colours.palette.m3onSurfaceVariant
              elide: Text.ElideMiddle
            }
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.status
                && (folderCard.modelData.status.error
                  || folderCard.modelData.status.state) || "unknown")
              color: folderCard.modelData.status
                && folderCard.modelData.status.error
                ? Colours.palette.m3error : Colours.palette.m3onSurfaceVariant
              elide: Text.ElideRight
            }
            RowLayout {
              TextButton {
                visible: root.moreOpen
                text: folderCard.modelData.paused
                  ? qsTr("Link") : qsTr("Unlink")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: Syncshell.setFolderPaused(
                  folderCard.modelData.id, !folderCard.modelData.paused)
              }
              TextButton {
                text: folderCard.modelData.paused
                  ? qsTr("Forget") : qsTr("Rescan")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: {
                  if (folderCard.modelData.paused)
                    root.requestForget(folderCard.modelData)
                  else Syncshell.rescanFolder(folderCard.modelData.id)
                }
              }
            }
          }
        }
      }
    }
  }

  TextButton {
    Layout.fillWidth: true
    text: root.moreOpen ? qsTr("Less") : qsTr("More")
    onClicked: root.moreOpen = !root.moreOpen
  }

  ColumnLayout {
    visible: root.moreOpen
    Layout.fillWidth: true

    TextButton {
      Layout.fillWidth: true
      text: root.addOpen ? qsTr("Cancel add folder") : qsTr("Add folder")
      enabled: Syncshell.online && !Syncshell.busy
      onClicked: root.addOpen = !root.addOpen
    }

    ColumnLayout {
      visible: root.addOpen
      Layout.fillWidth: true

      StyledText {
        Layout.fillWidth: true
        text: qsTr("ADD FOLDER")
        color: Colours.palette.m3onSurfaceVariant
      }
      StyledTextField {
        id: pathField
        Layout.fillWidth: true
        placeholderText: qsTr("/path/to/existing/folder")
      }
      StyledTextField {
        id: labelField
        Layout.fillWidth: true
        placeholderText: qsTr("Label")
      }
      RowLayout {
        Layout.fillWidth: true
        StyledTextField {
          id: idField
          Layout.fillWidth: true
          placeholderText: qsTr("Folder ID")
        }
        TextButton {
          text: qsTr("New ID")
          enabled: Syncshell.online && !Syncshell.busy
          onClicked: Syncshell.requestFolderIdSuggestion()
        }
      }
      StyledText {
        Layout.fillWidth: true
        text: qsTr("Reuse the exact ID to rejoin a remote folder. "
          + "A new ID creates a different folder identity.")
        color: Colours.palette.m3onSurfaceVariant
        wrapMode: Text.Wrap
      }
      TextButton {
        Layout.fillWidth: true
        text: Syncshell.busy ? qsTr("Adding...") : qsTr("Add folder")
        enabled: Syncshell.online && !Syncshell.busy
          && pathField.text.length > 0 && idField.text.length > 0
        onClicked: Syncshell.addFolder({
          path: pathField.text,
          label: labelField.text,
          folderId: idField.text,
          deviceIds: []
        })
      }
    }
  }

  StyledRect {
    visible: root.pendingForgetId !== ""
    Layout.fillWidth: true
    implicitHeight: forgetContent.implicitHeight + Tokens.padding.medium * 2
    color: Colours.tPalette.m3surfaceContainer
    radius: Tokens.rounding.medium
    border.width: 1
    border.color: Colours.palette.m3error

    ColumnLayout {
      id: forgetContent
      anchors.fill: parent
      anchors.margins: Tokens.padding.medium

      StyledText {
        Layout.fillWidth: true
        text: "Forget " + root.pendingForgetLabel + " ("
          + root.pendingForgetId + ")? The directory and data files will "
          + "not be deleted. Rejoining requires this Folder ID."
        color: Colours.palette.m3error
        wrapMode: Text.Wrap
      }
      RowLayout {
        TextButton {
          text: qsTr("Cancel")
          onClicked: root.pendingForgetId = ""
        }
        TextButton {
          text: qsTr("Forget")
          enabled: !Syncshell.busy
          onClicked: root.confirmForget()
        }
      }
    }
  }

  RowLayout {
    Layout.fillWidth: true
    TextButton {
      text: qsTr("Web UI")
      enabled: Syncshell.online
      onClicked: Syncshell.openWebUi()
    }
  }

  RowLayout {
    Layout.fillWidth: true
    TextButton {
      text: qsTr("Rescan all")
      enabled: Syncshell.online && !Syncshell.busy
        && Syncshell.folderCount > 0
      onClicked: Syncshell.rescanAllFolders()
    }
    TextButton {
      text: qsTr("Refresh status")
      enabled: !Syncshell.refreshing && !Syncshell.busy
      onClicked: Syncshell.refresh()
    }
  }

  Connections {
    target: Syncshell
    function onFolderIdSuggestionChanged() {
      if (!idField.activeFocus && Syncshell.folderIdSuggestion)
        idField.text = Syncshell.folderIdSuggestion
    }
  }
}
