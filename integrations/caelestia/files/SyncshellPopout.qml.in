pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Layouts
import Caelestia.Config
import qs.components
import qs.components.controls
import qs.services
import "../../../syncshell/shared"

ColumnLayout {
  id: root
  implicitWidth: 420
  spacing: Tokens.spacing.medium
  property bool moreOpen: false
  property bool addOpen: false
  property string pendingForgetId: ""
  property string pendingForgetLabel: ""
  property DeviceWorkflow deviceFlow: DeviceWorkflow { service: Syncshell }

  function requestForget(folder) {
    pendingForgetId = String(folder.id || "")
    pendingForgetLabel = String(folder.label || folder.id || "folder")
  }

  function confirmForget() {
    if (pendingForgetId === "") return
    if (Syncshell.forgetFolder(pendingForgetId)) pendingForgetId = ""
  }

  Keys.onPressed: function(event) {
    if (event.key === Qt.Key_Escape && pendingForgetId !== "") {
      pendingForgetId = ""
      event.accepted = true
    } else if (event.key === Qt.Key_Escape && deviceFlow.view !== "") {
      deviceFlow.close()
      event.accepted = true
    } else {
      event.accepted = false
    }
  }

  StyledText {
    Layout.fillWidth: true
    text: qsTr("Syncshell")
    color: Colours.palette.m3primary
    font: Tokens.font.title.medium
  }

  StyledText {
    Layout.fillWidth: true
    text: Syncshell.summaryText
  }

  StyledText {
    Layout.fillWidth: true
    visible: text.length > 0
    text: Syncshell.lastError || Syncshell.actionNotice
    color: Syncshell.lastError ? Colours.palette.m3error
      : Colours.palette.m3primary
    wrapMode: Text.Wrap
  }

  StyledText {
    visible: root.deviceFlow.view === ""
    Layout.fillWidth: true
    text: qsTr("FOLDERS")
    color: Colours.palette.m3onSurfaceVariant
  }

  Flickable {
    visible: root.deviceFlow.view === ""
    id: folderView
    Layout.fillWidth: true
    Layout.preferredHeight: Math.min(300,
      Math.max(60, folderColumn.implicitHeight))
    clip: true
    contentWidth: width
    contentHeight: folderColumn.implicitHeight
    boundsBehavior: Flickable.StopAtBounds

    Column {
      id: folderColumn
      width: folderView.width
      spacing: Tokens.spacing.small

      StyledText {
        width: parent.width
        visible: Syncshell.folders.length === 0
        text: Syncshell.summaryText
        color: Colours.palette.m3onSurfaceVariant
        horizontalAlignment: Text.AlignHCenter
      }

      Repeater {
        model: Syncshell.folders
        delegate: StyledRect {
          id: folderCard
          required property var modelData
          width: folderColumn.width
          height: details.implicitHeight + Tokens.padding.medium * 2
          color: Colours.tPalette.m3surfaceContainer
          radius: Tokens.rounding.medium

          ColumnLayout {
            id: details
            anchors.fill: parent
            anchors.margins: Tokens.padding.medium
            spacing: Tokens.spacing.small
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.label
                || folderCard.modelData.id)
              font: Tokens.font.label.large
            }
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.path || "")
              color: Colours.palette.m3onSurfaceVariant
              elide: Text.ElideMiddle
            }
            StyledText {
              Layout.fillWidth: true
              text: String(folderCard.modelData.status
                && (folderCard.modelData.status.error
                  || folderCard.modelData.status.state) || "unknown")
              color: folderCard.modelData.status
                && folderCard.modelData.status.error
                ? Colours.palette.m3error : Colours.palette.m3onSurfaceVariant
              elide: Text.ElideRight
            }
            RowLayout {
              TextButton {
                visible: root.moreOpen
                text: folderCard.modelData.paused
                  ? qsTr("Link") : qsTr("Unlink")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: Syncshell.setFolderPaused(
                  folderCard.modelData.id, !folderCard.modelData.paused)
              }
              TextButton {
                visible: root.moreOpen
                  && Syncshell.shareableDevices().length > 0
                text: qsTr("Share")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: {
                  root.addOpen = false
                  root.deviceFlow.beginFolderSharing(folderCard.modelData)
                }
              }
              TextButton {
                text: folderCard.modelData.paused
                  ? qsTr("Forget") : qsTr("Rescan")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: {
                  if (folderCard.modelData.paused)
                    root.requestForget(folderCard.modelData)
                  else Syncshell.rescanFolder(folderCard.modelData.id)
                }
              }
            }
          }
        }
      }
    }
  }

  TextButton {
    visible: root.deviceFlow.view === ""
    Layout.fillWidth: true
    text: root.moreOpen ? qsTr("Less") : qsTr("More")
    onClicked: root.moreOpen = !root.moreOpen
  }

  ColumnLayout {
    visible: root.moreOpen
    Layout.fillWidth: true

    TextButton {
      visible: root.deviceFlow.view === ""
      Layout.fillWidth: true
      text: root.addOpen ? qsTr("Cancel add folder") : qsTr("Add folder")
      enabled: Syncshell.online && !Syncshell.busy
      onClicked: {
        root.deviceFlow.close()
        root.deviceFlow.resetFolderDraft()
        root.addOpen = !root.addOpen
      }
    }

    ColumnLayout {
      visible: root.addOpen && root.deviceFlow.view === ""
      Layout.fillWidth: true

      StyledText {
        Layout.fillWidth: true
        text: qsTr("ADD FOLDER")
        color: Colours.palette.m3onSurfaceVariant
      }
      Repeater {
        model: Syncshell.pendingFolderOffers()
        delegate: TextButton {
          required property var modelData
          Layout.fillWidth: true
          text: (modelData.encrypted ? "Encrypted offer: " : "Accept ")
            + modelData.label + " from "
            + Syncshell.deviceName(modelData.deviceId)
          enabled: !modelData.encrypted
          onClicked: idField.text
              = root.deviceFlow.selectPendingFolder(modelData)
        }
      }
      StyledTextField {
        id: pathField
        Layout.fillWidth: true
        placeholderText: qsTr("/path/to/existing/folder")
      }
      StyledTextField {
        id: labelField
        Layout.fillWidth: true
        placeholderText: qsTr("Label")
      }
      RowLayout {
        Layout.fillWidth: true
        StyledTextField {
          id: idField
          Layout.fillWidth: true
          placeholderText: qsTr("Folder ID")
        }
        TextButton {
          text: qsTr("New ID")
          enabled: Syncshell.online && !Syncshell.busy
          onClicked: Syncshell.requestFolderIdSuggestion()
        }
      }
      StyledText {
        Layout.fillWidth: true
        text: qsTr("Reuse the exact ID to rejoin a remote folder. "
          + "A new ID creates a different folder identity.")
        color: Colours.palette.m3onSurfaceVariant
        wrapMode: Text.Wrap
      }
      Repeater {
        model: Syncshell.shareableDevices()
        delegate: TextButton {
          required property var modelData
          Layout.fillWidth: true
          text: (root.deviceFlow.draftIds.indexOf(modelData.id) >= 0
            ? "[x] Share with " : "[ ] Share with ")
            + String(modelData.name || root.deviceFlow.shortId(modelData.id))
          onClicked: root.deviceFlow.toggleDraft(String(modelData.id || ""))
        }
      }
      TextButton {
        Layout.fillWidth: true
        text: Syncshell.busy ? qsTr("Adding...") : qsTr("Add folder")
        enabled: Syncshell.online && !Syncshell.busy
          && pathField.text.length > 0 && idField.text.length > 0
        onClicked: Syncshell.addFolder({
          path: pathField.text,
          label: labelField.text,
          folderId: idField.text,
          deviceIds: root.deviceFlow.draftIds,
          pendingDeviceId: root.deviceFlow.pendingDeviceId(idField.text)
        })
      }
    }

    StyledText {
      visible: root.deviceFlow.view === ""
      Layout.fillWidth: true
      text: qsTr("REMOTE DEVICES")
      color: Colours.palette.m3onSurfaceVariant
    }

    Repeater {
      model: root.deviceFlow.view === "" ? Syncshell.remoteDevices() : []
      delegate: RowLayout {
        required property var modelData
        Layout.fillWidth: true
        StyledText {
          Layout.fillWidth: true
          text: String(modelData.name || root.deviceFlow.shortId(modelData.id))
            + " · " + Syncshell.folderIdsForDevice(modelData.id).length
            + " folders · "
            + (modelData.connected ? "connected" : "disconnected")
          color: modelData.connected ? Colours.palette.m3primary
            : Colours.palette.m3onSurfaceVariant
          elide: Text.ElideRight
        }
        TextButton {
          text: qsTr("Folders")
          enabled: !Syncshell.busy
          onClicked: {
            root.addOpen = false
            root.deviceFlow.beginDeviceFolders(modelData)
          }
        }
      }
    }

    TextButton {
      visible: root.deviceFlow.view === ""
      Layout.fillWidth: true
      text: qsTr("Add remote device")
      enabled: Syncshell.online && !Syncshell.busy
      onClicked: {
        root.addOpen = false
        root.deviceFlow.beginAddDevice(null)
      }
    }

    Repeater {
      model: root.deviceFlow.view === "" ? Syncshell.pendingDevices : []
      delegate: RowLayout {
        required property var modelData
        Layout.fillWidth: true
        StyledText {
          Layout.fillWidth: true
          text: String(modelData.name || root.deviceFlow.shortId(modelData.id))
            + " wants to connect"
          elide: Text.ElideRight
        }
        TextButton {
          text: qsTr("Accept")
          enabled: !Syncshell.busy
          onClicked: {
            root.addOpen = false
            root.deviceFlow.beginAddDevice(modelData)
          }
        }
        TextButton {
          text: qsTr("Dismiss")
          enabled: !Syncshell.busy
          onClicked: {
            root.addOpen = false
            root.deviceFlow.beginDismissDevice(modelData)
          }
        }
      }
    }

    ColumnLayout {
      visible: root.deviceFlow.view === "add-device"
      Layout.fillWidth: true
      StyledText {
        Layout.fillWidth: true
        text: qsTr("ADD REMOTE DEVICE")
        color: Colours.palette.m3onSurfaceVariant
      }
      Repeater {
        model: Syncshell.nearbyDevices
        delegate: TextButton {
          required property var modelData
          Layout.fillWidth: true
          text: "Use nearby " + root.deviceFlow.shortId(modelData.id)
          onClicked: root.deviceFlow.targetDeviceId = String(modelData.id || "")
        }
      }
      StyledTextField {
        Layout.fillWidth: true
        placeholderText: qsTr("Device ID")
        text: root.deviceFlow.targetDeviceId
        onTextChanged: root.deviceFlow.targetDeviceId = text.toUpperCase()
      }
      StyledTextField {
        Layout.fillWidth: true
        placeholderText: qsTr("Remote device name (optional)")
        text: root.deviceFlow.targetDeviceName
        onTextChanged: root.deviceFlow.targetDeviceName = text
      }
      RowLayout {
        TextButton {
          text: qsTr("Cancel")
          onClicked: root.deviceFlow.close()
        }
        TextButton {
          text: Syncshell.busy ? qsTr("Adding...") : qsTr("Add")
          enabled: !Syncshell.busy && root.deviceFlow.targetDeviceId !== ""
          onClicked: Syncshell.addDevice(root.deviceFlow.targetDeviceId,
            root.deviceFlow.targetDeviceName)
        }
      }
    }

    ColumnLayout {
      visible: root.deviceFlow.view === "share-folder"
      Layout.fillWidth: true
      StyledText {
        Layout.fillWidth: true
        text: "SHARE " + Syncshell.folderLabel(root.deviceFlow.targetFolderId)
        color: Colours.palette.m3onSurfaceVariant
      }
      Repeater {
        model: Syncshell.shareableDevices()
        delegate: TextButton {
          required property var modelData
          Layout.fillWidth: true
          text: (root.deviceFlow.draftIds.indexOf(modelData.id) >= 0
            ? "[x] " : "[ ] ")
            + String(modelData.name || root.deviceFlow.shortId(modelData.id))
          onClicked: root.deviceFlow.toggleDraft(String(modelData.id || ""))
        }
      }
      RowLayout {
        TextButton {
          text: qsTr("Cancel")
          onClicked: root.deviceFlow.close()
        }
        TextButton {
          text: qsTr("Save sharing")
          enabled: !Syncshell.busy
          onClicked: Syncshell.setFolderSharing(
            root.deviceFlow.targetFolderId, root.deviceFlow.draftIds)
        }
      }
    }

    ColumnLayout {
      visible: root.deviceFlow.view === "device-folders"
      Layout.fillWidth: true
      StyledText {
        Layout.fillWidth: true
        text: "SHARED WITH " + (root.deviceFlow.targetDeviceName
          || root.deviceFlow.shortId(root.deviceFlow.targetDeviceId))
        color: Colours.palette.m3onSurfaceVariant
      }
      Repeater {
        model: Syncshell.folderIdsForDevice(root.deviceFlow.targetDeviceId)
        delegate: TextButton {
          required property var modelData
          Layout.fillWidth: true
          text: (root.deviceFlow.draftIds.indexOf(modelData) >= 0
            ? "[x] " : "[ ] ") + Syncshell.folderLabel(modelData)
          onClicked: root.deviceFlow.toggleDraft(String(modelData || ""))
        }
      }
      RowLayout {
        TextButton {
          text: qsTr("Cancel")
          onClicked: root.deviceFlow.close()
        }
        TextButton {
          text: qsTr("Save sharing")
          enabled: !Syncshell.busy && root.deviceFlow.removedFolderIds().length > 0
          onClicked: Syncshell.removeDeviceFolderShares(
            root.deviceFlow.targetDeviceId, root.deviceFlow.removedFolderIds(),
            root.deviceFlow.targetDeviceName)
        }
      }
    }

    StyledRect {
      visible: root.deviceFlow.view === "dismiss-device"
      Layout.fillWidth: true
      implicitHeight: dismissDeviceContent.implicitHeight
        + Tokens.padding.medium * 2
      color: Colours.tPalette.m3surfaceContainer
      radius: Tokens.rounding.medium
      border.width: 1
      border.color: Colours.palette.m3error
      ColumnLayout {
        id: dismissDeviceContent
        anchors.fill: parent
        anchors.margins: Tokens.padding.medium
        StyledText {
          Layout.fillWidth: true
          text: "Dismiss pending request from "
            + (root.deviceFlow.targetDeviceName
              || root.deviceFlow.shortId(root.deviceFlow.targetDeviceId)) + "?"
          color: Colours.palette.m3error
        }
        RowLayout {
          TextButton {
            text: qsTr("Cancel")
            onClicked: root.deviceFlow.close()
          }
          TextButton {
            text: qsTr("Dismiss")
            enabled: !Syncshell.busy
            onClicked: Syncshell.dismissPendingDevice(
              root.deviceFlow.targetDeviceId, root.deviceFlow.targetDeviceName)
          }
        }
      }
    }
  }

  StyledRect {
    visible: root.pendingForgetId !== ""
    Layout.fillWidth: true
    implicitHeight: forgetContent.implicitHeight + Tokens.padding.medium * 2
    color: Colours.tPalette.m3surfaceContainer
    radius: Tokens.rounding.medium
    border.width: 1
    border.color: Colours.palette.m3error

    ColumnLayout {
      id: forgetContent
      anchors.fill: parent
      anchors.margins: Tokens.padding.medium

      StyledText {
        Layout.fillWidth: true
        text: "Forget " + root.pendingForgetLabel + " ("
          + root.pendingForgetId + ")? The directory and data files will "
          + "not be deleted. Rejoining requires this Folder ID."
        color: Colours.palette.m3error
        wrapMode: Text.Wrap
      }
      RowLayout {
        TextButton {
          text: qsTr("Cancel")
          onClicked: root.pendingForgetId = ""
        }
        TextButton {
          text: qsTr("Forget")
          enabled: !Syncshell.busy
          onClicked: root.confirmForget()
        }
      }
    }
  }

  RowLayout {
    Layout.fillWidth: true
    TextButton {
      text: qsTr("Web UI")
      enabled: Syncshell.online
      onClicked: Syncshell.openWebUi()
    }
  }

  RowLayout {
    Layout.fillWidth: true
    TextButton {
      text: qsTr("Rescan all")
      enabled: Syncshell.online && !Syncshell.busy
        && Syncshell.folderCount > 0
      onClicked: Syncshell.rescanAllFolders()
    }
    TextButton {
      text: qsTr("Refresh status")
      enabled: !Syncshell.refreshing && !Syncshell.busy
      onClicked: Syncshell.refresh()
    }
  }

  Connections {
    target: Syncshell
    function onFolderIdSuggestionChanged() {
      if (!idField.activeFocus && Syncshell.folderIdSuggestion)
        idField.text = Syncshell.folderIdSuggestion
    }
    function onActionFinished(action, ok) {
      root.deviceFlow.actionFinished(action, ok)
    }
  }
}
