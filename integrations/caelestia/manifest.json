{
  "name": "Syncshell",
  "author": "syncshell",
  "version": "0.2.2",
  "description": "Native Syncthing controls for Caelestia (experimental loader)",
  "icon": "sync",
  "requires": ">=2.2.0",
  "settings": "integrations/caelestia/Settings.qml",
  "entryPoints": [
    {
      "type": "bar-entry",
      "source": "hosts/caelestia/CaelestiaBarEntry.qml",
      "properties": {
        "name": "syncshell"
      }
    },
    {
      "type": "bar-popout",
      "source": "hosts/caelestia/CaelestiaPanel.qml",
      "properties": {
        "entry": "syncshell-overview"
      }
    }
  ]
}
