{
  "id": "syncshell",
  "name": "Syncshell",
  "description": "Monitor synchronization and manage folders, devices, sharing, and invitations from DMS (Dux Shell)",
  "version": "0.2.4",
  "author": "ilyaZar",
  "type": "composite",
  "capabilities": ["daemon", "dankbar-widget", "monitoring"],
  "icon": "sync",
  "components": {
    "daemon": "./hosts/dux-shell/DuxShellService.qml",
    "widget": "./hosts/dux-shell/DuxShellPanel.qml"
  },
  "settings": "./hosts/dux-shell/ui/SettingsMenu.qml",
  "requires_dms": ">=2.0.0",
  "dependencies": ["syncthing"],
  "permissions": ["process", "network", "settings_read", "settings_write"]
}
