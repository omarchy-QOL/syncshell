{
  "id": "syncshell",
  "name": "Syncshell",
  "description": "Monitor synchronization and manage folders, devices, sharing, and invitations from DankMaterialShell",
  "version": "0.2.4",
  "author": "ilyaZar",
  "type": "composite",
  "capabilities": ["daemon", "dankbar-widget", "monitoring"],
  "icon": "sync",
  "components": {
    "daemon": "./hosts/dankmaterialshell/DankService.qml",
    "widget": "./hosts/dankmaterialshell/DankPanel.qml"
  },
  "settings": "./hosts/dankmaterialshell/ui/PluginSettings.qml",
  "requires_dms": ">=1.6.2",
  "dependencies": ["syncthing"],
  "permissions": ["process", "network", "settings_read", "settings_write"]
}
