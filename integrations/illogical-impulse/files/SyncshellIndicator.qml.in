import QtQuick
import qs.modules.common
import qs.modules.common.widgets
import qs.services

MouseArea {
  id: root

  implicitWidth: icon.implicitWidth + 8
  implicitHeight: Appearance.sizes.barHeight
  onClicked: popup.pinned = !popup.pinned

  MaterialSymbol {
    id: icon
    anchors.centerIn: parent
    text: !Syncshell.online ? "sync_problem"
      : Syncshell.syncingFolderCount > 0 ? "sync" : "sync_alt"
    iconSize: Appearance.font.pixelSize.larger
    color: Syncshell.folderProblemCount > 0
      ? Appearance.m3colors.m3error : Appearance.colors.colOnLayer0
    fill: Syncshell.online ? 1 : 0
  }

  SyncshellPopup { id: popup }
}
