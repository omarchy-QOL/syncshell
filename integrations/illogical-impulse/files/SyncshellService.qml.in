pragma Singleton

import QtQuick
import Quickshell
import "../syncshell/shared"

AdapterService {
  pluginRoot: localPath(Qt.resolvedUrl("../syncshell"))
  hostId: "illogical-impulse"

  function localPath(url) {
    var value = String(url || "")
    if (value.indexOf("file://") === 0) value = value.slice(7)
    return decodeURIComponent(value)
  }
}
