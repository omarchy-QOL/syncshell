pragma ComponentBehavior: Bound

import QtQuick
import QtQuick.Effects
import QtQuick.Layouts
import qs.modules.common
import qs.modules.common.widgets
import qs.services
import Quickshell
import Quickshell.Hyprland
import Quickshell.Wayland

LazyLoader {
  id: root
  property bool pinned: false
  property bool moreOpen: false
  property bool addOpen: false
  property string pendingForgetId: ""
  property string pendingForgetLabel: ""
  active: pinned

  function requestForget(folder) {
    pendingForgetId = String(folder.id || "")
    pendingForgetLabel = String(folder.label || folder.id || "folder")
  }

  function confirmForget() {
    if (pendingForgetId === "") return
    if (Syncshell.forgetFolder(pendingForgetId)) pendingForgetId = ""
  }

  component: PanelWindow {
    id: popupWindow
    color: "transparent"
    screen: root.QsWindow.window?.screen
    implicitWidth: popupBackground.implicitWidth
      + Appearance.sizes.elevationMargin * 2
    implicitHeight: popupBackground.implicitHeight
      + Appearance.sizes.elevationMargin * 2
    anchors.right: true
    anchors.top: !Config.options.bar.bottom
    anchors.bottom: Config.options.bar.bottom
    margins.right: Appearance.rounding.screenRounding
    margins.top: Config.options.bar.bottom ? 0 : Appearance.sizes.barHeight
    margins.bottom: Config.options.bar.bottom ? Appearance.sizes.barHeight : 0
    exclusionMode: ExclusionMode.Ignore
    exclusiveZone: 0
    WlrLayershell.namespace: "quickshell:syncshell"
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand

    mask: Region { item: popupBackground }
    Keys.onEscapePressed: {
      if (root.pendingForgetId !== "") root.pendingForgetId = ""
      else root.pinned = false
    }

    HyprlandFocusGrab {
      active: true
      windows: [popupWindow]
      onCleared: root.pinned = false
    }

    StyledRectangularShadow { target: popupBackground }

    Rectangle {
      id: popupBackground
      anchors.fill: parent
      anchors.margins: Appearance.sizes.elevationMargin
      implicitWidth: 440
      implicitHeight: content.implicitHeight + 20
      color: Appearance.m3colors.m3surfaceContainer
      radius: Appearance.rounding.small
      border.width: 1
      border.color: Appearance.colors.colLayer0Border

      ColumnLayout {
        id: content
        anchors.fill: parent
        anchors.margins: 10
        spacing: 8

        StyledPopupHeaderRow {
          icon: "sync_alt"
          label: Translation.tr("Syncshell")
        }

        StyledText {
          Layout.fillWidth: true
          text: Syncshell.summaryText
          color: Appearance.colors.colOnSurfaceVariant
        }

        StyledText {
          Layout.fillWidth: true
          visible: text.length > 0
          text: Syncshell.lastError || Syncshell.actionNotice
          color: Syncshell.lastError ? Appearance.m3colors.m3error
            : Appearance.m3colors.m3primary
          wrapMode: Text.Wrap
        }

        StyledText {
          Layout.fillWidth: true
          text: Translation.tr("FOLDERS")
          color: Appearance.colors.colOnSurfaceVariant
        }

        Flickable {
          id: folderView
          Layout.fillWidth: true
          Layout.preferredHeight: Math.min(300,
            Math.max(70, folderColumn.implicitHeight))
          clip: true
          contentWidth: width
          contentHeight: folderColumn.implicitHeight
          boundsBehavior: Flickable.StopAtBounds

          Column {
            id: folderColumn
            width: folderView.width
            spacing: 6

            StyledText {
              width: parent.width
              visible: Syncshell.folders.length === 0
              text: Syncshell.summaryText
              color: Appearance.colors.colOnSurfaceVariant
              horizontalAlignment: Text.AlignHCenter
            }

            Repeater {
              model: Syncshell.folders
              delegate: Rectangle {
                id: folderCard
                required property var modelData
                width: folderColumn.width
                height: folderDetails.implicitHeight + 16
                color: Appearance.colors.colLayer2
                radius: Appearance.rounding.small

                ColumnLayout {
                  id: folderDetails
                  anchors.fill: parent
                  anchors.margins: 8
                  spacing: 4
                  StyledText {
                    Layout.fillWidth: true
                    text: String(folderCard.modelData.label
                      || folderCard.modelData.id)
                    font.pixelSize: Appearance.font.pixelSize.normal
                  }
                  StyledText {
                    Layout.fillWidth: true
                    text: String(folderCard.modelData.path || "")
                    color: Appearance.colors.colOnSurfaceVariant
                    elide: Text.ElideMiddle
                  }
                  StyledText {
                    Layout.fillWidth: true
                    text: String(folderCard.modelData.status
                      && (folderCard.modelData.status.error
                        || folderCard.modelData.status.state) || "unknown")
                    color: folderCard.modelData.status
                      && folderCard.modelData.status.error
                      ? Appearance.m3colors.m3error
                      : Appearance.colors.colOnSurfaceVariant
                    elide: Text.ElideRight
                  }
                  RowLayout {
                    DialogButton {
                      visible: root.moreOpen
                      buttonText: folderCard.modelData.paused
                        ? Translation.tr("Link") : Translation.tr("Unlink")
                      enabled: Syncshell.online && !Syncshell.busy
                      onClicked: Syncshell.setFolderPaused(
                        folderCard.modelData.id, !folderCard.modelData.paused)
                    }
                    DialogButton {
                      buttonText: folderCard.modelData.paused
                        ? Translation.tr("Forget")
                        : Translation.tr("Rescan")
                      enabled: Syncshell.online && !Syncshell.busy
                      onClicked: {
                        if (folderCard.modelData.paused)
                          root.requestForget(folderCard.modelData)
                        else Syncshell.rescanFolder(folderCard.modelData.id)
                      }
                    }
                  }
                }
              }
            }
          }
        }

        DialogButton {
          Layout.fillWidth: true
          buttonText: root.moreOpen ? Translation.tr("Less")
            : Translation.tr("More")
          onClicked: root.moreOpen = !root.moreOpen
        }

        ColumnLayout {
          visible: root.moreOpen
          Layout.fillWidth: true

          DialogButton {
            Layout.fillWidth: true
            buttonText: root.addOpen ? Translation.tr("Cancel add folder")
              : Translation.tr("Add folder")
            enabled: Syncshell.online && !Syncshell.busy
            onClicked: root.addOpen = !root.addOpen
          }

          ColumnLayout {
            visible: root.addOpen
            Layout.fillWidth: true

            StyledText {
              Layout.fillWidth: true
              text: Translation.tr("ADD FOLDER")
              color: Appearance.colors.colOnSurfaceVariant
            }
            MaterialTextField {
              id: pathField
              Layout.fillWidth: true
              placeholderText: Translation.tr(
                "/path/to/existing/folder")
            }
            MaterialTextField {
              id: labelField
              Layout.fillWidth: true
              placeholderText: Translation.tr("Label")
            }
            RowLayout {
              Layout.fillWidth: true
              MaterialTextField {
                id: idField
                Layout.fillWidth: true
                placeholderText: Translation.tr("Folder ID")
              }
              DialogButton {
                buttonText: Translation.tr("New ID")
                enabled: Syncshell.online && !Syncshell.busy
                onClicked: Syncshell.requestFolderIdSuggestion()
              }
            }
            StyledText {
              Layout.fillWidth: true
              text: Translation.tr("Reuse the exact ID to rejoin a remote "
                + "folder. A new ID creates a different folder identity.")
              color: Appearance.colors.colOnSurfaceVariant
              wrapMode: Text.Wrap
            }
            DialogButton {
              Layout.fillWidth: true
              buttonText: Syncshell.busy ? Translation.tr("Adding...")
                : Translation.tr("Add folder")
              enabled: Syncshell.online && !Syncshell.busy
                && pathField.text.length > 0 && idField.text.length > 0
              onClicked: Syncshell.addFolder({
                path: pathField.text,
                label: labelField.text,
                folderId: idField.text,
                deviceIds: []
              })
            }
          }
        }

        Rectangle {
          visible: root.pendingForgetId !== ""
          Layout.fillWidth: true
          implicitHeight: forgetContent.implicitHeight + 16
          color: Appearance.colors.colLayer2
          radius: Appearance.rounding.small
          border.width: 1
          border.color: Appearance.m3colors.m3error

          ColumnLayout {
            id: forgetContent
            anchors.fill: parent
            anchors.margins: 8

            StyledText {
              Layout.fillWidth: true
              text: "Forget " + root.pendingForgetLabel
                + " (" + root.pendingForgetId + ")? The directory and data "
                + "files will not be deleted. Rejoining requires this "
                + "Folder ID."
              color: Appearance.m3colors.m3error
              wrapMode: Text.Wrap
            }
            RowLayout {
              DialogButton {
                buttonText: Translation.tr("Cancel")
                onClicked: root.pendingForgetId = ""
              }
              DialogButton {
                buttonText: Translation.tr("Forget")
                enabled: !Syncshell.busy
                onClicked: root.confirmForget()
              }
            }
          }
        }

        RowLayout {
          Layout.fillWidth: true
          DialogButton {
            buttonText: Translation.tr("Web UI")
            enabled: Syncshell.online
            onClicked: Syncshell.openWebUi()
          }
        }

        RowLayout {
          Layout.fillWidth: true
          DialogButton {
            buttonText: Translation.tr("Rescan all")
            enabled: Syncshell.online && !Syncshell.busy
              && Syncshell.folderCount > 0
            onClicked: Syncshell.rescanAllFolders()
          }
          DialogButton {
            buttonText: Translation.tr("Refresh status")
            enabled: !Syncshell.busy && !Syncshell.refreshing
            onClicked: Syncshell.refresh()
          }
        }
      }

      Connections {
        target: Syncshell
        function onFolderIdSuggestionChanged() {
          if (!idField.activeFocus && Syncshell.folderIdSuggestion)
            idField.text = Syncshell.folderIdSuggestion
        }
      }
    }
  }
}
